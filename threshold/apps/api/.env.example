# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker: postgresql://threshold:threshold123@localhost:5432/threshold
# Supabase: Project Settings → Database → Connection string → URI mode
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-32-plus-char-random-string

# ─── Strava OAuth ────────────────────────────────────────────────────────────
# Create TWO apps at https://www.strava.com/settings/api:
#   "Threshold Dev"  → Authorization Callback Domain: localhost
#   "Threshold Prod" → Authorization Callback Domain: your-api-domain.com
# Use dev credentials here; prod credentials go in Railway dashboard only.
STRAVA_CLIENT_ID=your-strava-client-id
STRAVA_CLIENT_SECRET=your-strava-client-secret

# ─── Polar OAuth ─────────────────────────────────────────────────────────────
# Create TWO apps at https://admin.polaraccesslink.com:
#   "Threshold Dev"  → Redirect URL: http://localhost:4003/api/polar/callback
#   "Threshold Prod" → Redirect URL: https://your-api-domain.com/api/polar/callback
# Use dev credentials here; prod credentials go in Railway dashboard only.
POLAR_CLIENT_ID=your-polar-client-id
POLAR_CLIENT_SECRET=your-polar-client-secret

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4003

# URL of the frontend (used for CORS).
# Local: http://localhost:4002  |  Prod: https://your-app.vercel.app
FRONTEND_URL=http://localhost:4002
